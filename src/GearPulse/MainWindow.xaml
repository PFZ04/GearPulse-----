<Window x:Class="GearPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GearPulse"
        Title="GearPulse | 外设脉动" Width="270" Height="88"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:SilhouetteSourceConverter x:Key="SilhouetteSource" />
        <local:LineIconVisibilityConverter x:Key="LineVisibility" />
    </Window.Resources>
    <Viewbox Stretch="Fill">
    <Border x:Name="CardBorder" Width="270" Height="88" CornerRadius="12" Background="#EB1C2028" Padding="12">
        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding VisibleStates}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                            <Path Width="40" Height="40" Fill="Transparent"
                                  Stroke="#DCE8F5" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Visibility>
                                    <MultiBinding Converter="{StaticResource LineVisibility}">
                                        <Binding Path="Icon" />
                                        <Binding Path="IconStyle" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Path.Visibility>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M6,12 L32,12 32,29 6,29 Z M35,17 L35,24 M13,17 L13,24 M18,17 L18,24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="headset">
                                                <Setter Property="Data" Value="M7,23 C7,12 12,6 20,6 C28,6 33,12 33,23 M5,22 L12,22 12,34 5,34 Z M28,22 L35,22 35,34 28,34 Z M32,30 C30,36 24,37 20,34" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="mouse">
                                                <Setter Property="Data" Value="M20,3 C14,3 11,7 11,13 L11,28 C11,34 15,37 20,37 C25,37 29,34 29,28 L29,13 C29,7 26,3 20,3 Z M20,4 L20,17 M15,19 L25,19" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="keyboard">
                                                <Setter Property="Data" Value="M3,13 L37,13 37,29 3,29 Z M8,18 L11,18 M15,18 L18,18 M22,18 L25,18 M29,18 L32,18 M8,23 L11,23 M15,23 L18,23 M22,23 L25,23 M29,23 L32,23 M12,27 L28,27" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="gamepad">
                                                <Setter Property="Data" Value="M12,15 L28,15 C32,15 34,17 35,21 L37,29 C38,33 35,35 32,32 L27,28 13,28 8,32 C5,35 2,33 3,29 L5,21 C6,17 8,15 12,15 Z M10,21 L18,21 M14,17 L14,25 M27,20 L27,21 M31,23 L31,24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Image Width="40" Height="40" Stretch="Uniform">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource SilhouetteSource}">
                                        <Binding Path="Icon" />
                                        <Binding Path="IconStyle" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="#DAE1EC"
                                       FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontFamily="Segoe UI" FontSize="12" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                <Setter Property="Foreground" Value="#FF9740" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Border>
    </Viewbox>
</Window>
